+  it.effect("bridges MCP ask_question asynchronously through T3 native user input", () =>
+    Effect.gen(function* () {
+      const adapter = yield* CursorAdapter;
+      const settings = yield* ServerSettingsService;
+      const threadId = ThreadId.make("cursor-mcp-user-input-bridge");
+
+      const wrapperPath = yield* Effect.promise(() => makeMockAgentWrapper());
+      yield* settings.updateSettings({ providers: { cursor: { binaryPath: wrapperPath } } });
+
+      yield* adapter.startSession({
+        threadId,
+        provider: ProviderDriverKind.make("cursor"),
+        cwd: process.cwd(),
+        runtimeMode: "full-access",
+        modelSelection: { instanceId: ProviderInstanceId.make("cursor"), model: "default" },
+      });
+
+      const requestedFiber = yield* adapter.streamEvents.pipe(
+        Stream.filter(
+          (event) => event.threadId === threadId && event.type === "user-input.requested",
+        ),
+        Stream.take(1),
+        Stream.runCollect,
+        Effect.forkChild,
+      );
+
+      // Give the stream consumer a scheduler turn before publishing the request.
+      yield* Effect.yieldNow;
+
+      const handler = McpUserInputBridge.read(threadId);
+      assert.isDefined(handler);
+      if (!handler) {
+        return;
+      }
+
+      const request = yield* handler.ask([
+        {
+          id: "color",
+          header: "Color",
+          question: "Which color do you prefer?",
+          options: [
+            { label: "Blue", description: "Blue", value: "blue" },
+            { label: "Green", description: "Green", value: "green" },
+            { label: "Red", description: "Red", value: "red" },
+          ],
+          allowCustomAnswer: false,
+          multiSelect: false,
+        },
+      ]);
+
+      const requestedEvents = Array.from(yield* Fiber.join(requestedFiber));
+      const requested = requestedEvents[0];
+
+      assert.isDefined(requested);
+      if (!requested || requested.type !== "user-input.requested") {
+        return;
+      }
+
+      assert.equal(request.requestId, String(requested.requestId));
+      assert.equal(requested.payload.questions[0]?.question, "Which color do you prefer?");
+      assert.deepStrictEqual(
+        requested.payload.questions[0]?.options.map((option) => option.value),
+        ["blue", "green", "red"],
+      );
+
+      assert.deepStrictEqual(yield* handler.wait(request.requestId, 10), {
+        requestId: request.requestId,
+        status: "pending",
+      });
+
+      yield* adapter.respondToUserInput(
+        threadId,
+        ApprovalRequestId.make(String(requested.requestId)),
+        { color: "blue" },
+      );
+
+      assert.deepStrictEqual(yield* handler.wait(request.requestId, 1_000), {
+        requestId: request.requestId,
+        status: "answered",
+        answers: { color: "blue" },
+      });
 
       yield* adapter.stopSession(threadId);
       assert.isUndefined(McpUserInputBridge.read(threadId));
