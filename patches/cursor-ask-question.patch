@@ -0,0 +1,52 @@
+import { ProviderUserInputAnswers, TrimmedNonEmptyString } from "@t3tools/contracts";
+import * as Schema from "effect/Schema";
+import { Tool, Toolkit } from "effect/unstable/ai";
+
+import * as McpInvocationContext from "../../McpInvocationContext.ts";
+
+const AskQuestionOption = Schema.Struct({
+  label: TrimmedNonEmptyString,
+  description: Schema.optional(Schema.String),
+  value: Schema.optional(Schema.String),
+});
+
+const AskQuestion = Schema.Struct({
+  id: Schema.optional(TrimmedNonEmptyString),
+  header: Schema.optional(TrimmedNonEmptyString),
+  question: TrimmedNonEmptyString,
+  options: Schema.Array(AskQuestionOption),
+  allowCustomAnswer: Schema.optional(Schema.Boolean),
+  multiSelect: Schema.optional(Schema.Boolean),
+});
+
+export class UserInputBridgeUnavailableError extends Schema.TaggedError<UserInputBridgeUnavailableError>()(
+  "UserInputBridgeUnavailableError",
+  {
+    threadId: Schema.String,
+  },
+) {
+  override get message(): string {
+    return `T3 Code native user input is unavailable for thread ${this.threadId}.`;
+  }
+}
+
+const AskQuestionTool = Tool.make("ask_question", {
+  description:
+    "Ask the user one or more questions through T3 Code's native interactive question UI and wait for their answers. Use this instead of writing clarification or multiple-choice questions as ordinary chat text when the native Cursor AskQuestion tool is unavailable in ACP.",
+  parameters: Schema.Struct({
+    title: Schema.optional(TrimmedNonEmptyString),
+    questions: Schema.Array(AskQuestion),
+  }),
+  success: Schema.Struct({
+    answers: ProviderUserInputAnswers,
+  }),
+  failure: UserInputBridgeUnavailableError,
+  dependencies: [McpInvocationContext.McpInvocationContext],
+})
+  .annotate(Tool.Title, "Ask user")
+  .annotate(Tool.Readonly, true)
+  .annotate(Tool.Destructive, false)
+  .annotate(Tool.Idempotent, false)
+  .annotate(Tool.OpenWorld, false);
+
+export const UserInputToolkit = Toolkit.make(AskQuestionTool);
