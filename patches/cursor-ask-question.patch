+import type { UserInputQuestion } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+
+import * as McpInvocationContext from "../../McpInvocationContext.ts";
+import * as McpUserInputBridge from "../../McpUserInputBridge.ts";
+import { UserInputBridgeUnavailableError, UserInputToolkit } from "./tools.ts";
+
+const make = Effect.gen(function* () {
+  return UserInputToolkit.of({
+    ask_question: (input) =>
+      Effect.gen(function* () {
+        const invocation = yield* McpInvocationContext.McpInvocationContext;
+        const handler = McpUserInputBridge.read(invocation.threadId);
+
+        if (!handler) {
+          return yield* new UserInputBridgeUnavailableError({
+            threadId: invocation.threadId,
+          });
+        }
+
+        const questions: ReadonlyArray<UserInputQuestion> = input.questions.map(
+          (question, index) => ({
+            id: question.id ?? `question-${index + 1}`,
+            header: question.header ?? input.title ?? "Question",
+            question: question.question,
+            options: question.options.map((option) => ({
+              label: option.label,
+              description: option.description ?? option.label,
+              ...(option.value !== undefined ? { value: option.value } : {}),
+            })),
+            allowCustomAnswer: question.allowCustomAnswer ?? true,
+            multiSelect: question.multiSelect ?? false,
+          }),
+        );
+
+        const answers = yield* handler(questions);
+
+        return { answers };
+      }),
+  });
+});
+
+export const UserInputToolkitHandlersLive = UserInputToolkit.toLayer(make);
