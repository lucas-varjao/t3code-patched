+import type { ProviderUserInputAnswers, ThreadId, UserInputQuestion } from "@t3tools/contracts";
+import type * as Effect from "effect/Effect";
+
+export type McpUserInputHandler = (
+  questions: ReadonlyArray<UserInputQuestion>,
+) => Effect.Effect<ProviderUserInputAnswers>;
+
+const handlers = new Map<ThreadId, McpUserInputHandler>();
+
+export function register(threadId: ThreadId, handler: McpUserInputHandler): void {
+  handlers.set(threadId, handler);
+}
+
+export function unregister(threadId: ThreadId): void {
+  handlers.delete(threadId);
+}
+
+export function read(threadId: ThreadId): McpUserInputHandler | undefined {
+  return handlers.get(threadId);
+}
